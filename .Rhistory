# Clean up the labels: replace underscores with spaces and capitalize
clean_label <- gsub("_", " ", v)
clean_label <- paste0(toupper(substr(clean_label, 1, 1)), substr(clean_label, 2, nchar(clean_label)))
ggplot(wtd_dets, aes_string(x = v)) +
geom_histogram(fill = "steelblue", color = "white", bins = 20) +
labs(x = clean_label, y = "Frequency") +
