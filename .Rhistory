# Cartographic helpers
library(ggspatial)     # north arrow, scale bar
library(cowplot)       # combining main map + inset
#This just sets up files for inputs (already created, must contain your files), and outputs
input_directory<-reproducible::checkPath(file.path(getwd(), "0. Map/inputs"), create = TRUE)
output_directory<-reproducible::checkPath(file.path(getwd(), "0. Map/outputs"), create = TRUE)
figure_directory<-reproducible::checkPath(file.path(getwd(), "0. Map/figures"), create = TRUE)
#read in the files we need
#For now just reading in the camera locations from the next folder (sin bin I know)
camloc<-read.csv(file.path(getwd(), "1. Species Response Variables/inputs/OSM_camera_deployment.csv"))
#Quickly widdle down the camloc file
camloc<-camloc%>%
dplyr::select(array, site, lat, long)
#Convert the points to an sf object
cams_sf <- st_as_sf(
camloc,
coords = c("long", "lat"),
crs = 4326   # WGS84 (lat/long)
)
#Choose a projected CRS for northern Alberta
map_crs <- 3400  # NAD83 / Alberta 10-TM Forest
cams_sf <- st_transform(cams_sf, map_crs)
#Pull a basemap
canada <- ne_countries(
country = "canada",
scale = "medium",
returnclass = "sf"
) %>%
st_transform(map_crs)
#Pull Alberta
provinces <- ne_states(
country = "canada",
returnclass = "sf"
) %>%
st_transform(map_crs)
bbox <- st_bbox(cams_sf)
bbox_expanded <- bbox
bbox_expanded[c("xmin", "ymin")] <- bbox[c("xmin", "ymin")] - 50000
bbox_expanded[c("xmax", "ymax")] <- bbox[c("xmax", "ymax")] + 50000
ggplot() +
# Alberta background
geom_sf(
data = alberta,
fill = "grey95",
color = "grey70",
linewidth = 0.3
) +
# Camera locations
geom_sf(
data = cams_sf,
color = "grey30",
size = 1.5,
alpha = 0.8
) +
# Zoom to study area
coord_sf(
xlim = c(bbox_expanded["xmin"], bbox_expanded["xmax"]),
ylim = c(bbox_expanded["ymin"], bbox_expanded["ymax"]),
expand = FALSE
) +
# Scale bar + north arrow
annotation_scale(
location = "bl",
width_hint = 0.3,
text_cex = 0.9
) +
annotation_north_arrow(
location = "tr",
which_north = "true",
style = north_arrow_fancy_orienteering
) +
# Clean theme
theme_minimal() +
theme(
panel.grid = element_blank(),
axis.title = element_blank(),
axis.text = element_text(size = 10)
)
