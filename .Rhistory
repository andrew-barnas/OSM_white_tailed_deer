#Young full interaction
m1_young<-glmmTMB::glmmTMB(cbind(n_young, (n_weeks - n_young)) ~
disturbance_index+
PC1 + PC2 + #Habitat covariates
wolf_index + #Wolf index
mean_snow_spatial*disturbance_index+
snow_anomaly*disturbance_index+
(1|array),
family = "binomial",
data = wtd_dets)
