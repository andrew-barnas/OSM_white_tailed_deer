# ==============================
# Camera locations map (CartoDB)
# ==============================
# Packages
library(sf)
library(ggplot2)
library(dplyr)
library(ggspatial)
library(geodata)
# ------------------------------
# 1. Convert camera table to sf
# ------------------------------
cams_sf <- st_as_sf(
camloc,
coords = c("long", "lat"),
crs = 4326   # WGS84 lat/long
)
# ------------------------------
# 2. Choose CRSs
# ------------------------------
analysis_crs <- 3400  # NAD83 / Alberta 10-TM Forest
plot_crs     <- 3857  # Web Mercator (required for map tiles)
cams_sf <- st_transform(cams_sf, analysis_crs)
# ------------------------------
# 3. Pull Alberta boundary (GADM)
# ------------------------------
can_prov <- gadm(
country = "CAN",
level = 1,
path = tempdir()
)
alberta <- st_as_sf(can_prov) %>%
st_transform(analysis_crs) %>%
filter(NAME_1 == "Alberta")
# ------------------------------
# 4. Transform to plotting CRS
# ------------------------------
cams_plot    <- st_transform(cams_sf, plot_crs)
alberta_plot <- st_transform(alberta, plot_crs)
# ------------------------------
# 5. Define map extent
# ------------------------------
bbox <- st_bbox(cams_plot)
bbox[c("xmin", "ymin")] <- bbox[c("xmin", "ymin")] - 50000
bbox[c("xmax", "ymax")] <- bbox[c("xmax", "ymax")] + 50000
# ------------------------------
# 6. Plot
# ------------------------------
ggplot() +
# Grey basemap tiles
annotation_map_tile(
type = "cartodb_positron",
zoom = 8
) +
# Alberta outline (subtle)
geom_sf(
data = alberta_plot,
fill = NA,
color = "grey60",
linewidth = 0.4
) +
# Camera locations
geom_sf(
data = cams_plot,
color = "grey20",
size = 1.6,
alpha = 0.9
) +
# Zoom to study area
coord_sf(
xlim = c(bbox["xmin"], bbox["xmax"]),
ylim = c(bbox["ymin"], bbox["ymax"]),
expand = FALSE
) +
# Scale bar
annotation_scale(
location = "bl",
width_hint = 0.25
) +
# North arrow ABOVE scale bar
annotation_north_arrow(
location = "bl",
which_north = "true",
pad_y = unit(1.3, "cm"),
pad_x = unit(0.5, "cm"),
style = north_arrow_fancy_orienteering
) +
# Clean theme
theme_void()
#Clear everything out and start fresh
rm(list=ls())
install.packages(c("cowplot", "googleway", "ggplot2", "ggrepel",
"ggspatial", "libwgeom", "sf", "rnaturalearth", "rnaturalearthdata")
