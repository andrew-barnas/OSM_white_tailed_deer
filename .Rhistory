wolverine_function<-function(n_sites = 146){
#Lets build some data
MAT<-runif(n_sites, -3, 3) #From figure 3
conifer<-runif(n_sites, 0, 50) #nothing to go off other than constraints
broadleaf<-runif(n_sites, 0, 50) #percentages I think
harvest<-runif(n_sites, 0, 50) #again, not sure...
lynx<-sample(c(0,1), size = n_sites, replace = TRUE) #Binary
prey<-sample(c(0,1), size = n_sites, replace = TRUE)  #Binary
effort<-round(runif(n_sites, 8, 122), digits = 0)/122 #days divided by 122 (needs better)
#True parameters
B0<- -6.53
B1_mat<--1.29
B2_conifer<-0.03
B3_broadleaf<-0.06
B4_harvest<--0.12
B5_lynx<-1.23
B6_prey<-1.04
B7_effort<-3.14
#linear predictor
linear_predictor<-B0+
B1_mat*MAT+
B2_conifer*conifer+
B3_broadleaf*broadleaf+
B4_harvest*harvest+
B5_lynx*lynx+
B6_prey*prey+
B7_effort*effort
prob<-plogis(linear_predictor)
wolverine<-rbinom(n_sites, 1, prob)
#Wrap that all into a dataframe
df<-data.frame(wolverine, MAT, conifer, broadleaf, harvest, lynx, prey, effort)
#Model it again
m1<-glm(wolverine ~ MAT + conifer + broadleaf + harvest + lynx + prey + effort,
family = "binomial",
data = df)
return(m1)
}
set.seed(420)
n_sims<- 5
start_time<-Sys.time()
wolverine_sims<-map(1:n_sims, ~wolverine_function())
