alpha = 0.15, colour = NA) +
scale_colour_manual(values = okabe_ito_polgyonal,
name = "Polygonal Index Quantile") +
scale_fill_manual(values = okabe_ito_polgyonal,
name = "Polygonal Index Quantile") +
ylab("Predicted Probability of\nWeekly Occurrence ± 95% CI") +
xlab("10 Year Average Winter\nSnow-Water Equivalent (kg/m²)") +
theme_classic(base_size = 15)+
ylim(young_axis_limits)
#And then the actual plot
