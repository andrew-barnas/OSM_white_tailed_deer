set.seed(420)
n_sims <- 500
classes <- c("males", "females", "young")
start_time <- Sys.time()
simple_model_selection_sims <-
expand_grid(
class = classes,
sim = 1:n_sims
) %>%
mutate(
model = map(class, ~ polygonal_model_simulation(class = .x))
)
end_time <- Sys.time()
#And extract those parameter estimates
param_estimates <- simple_model_selection_sims %>%
mutate(
tidy = map(model, ~ broom.mixed::tidy(.x))
) %>%
unnest(tidy)%>%
dplyr::select(class, sim, term, estimate)
