"polygonal_index:mean_snow_spatial" = "Polygonal Index × Mean Snow",
"polygonal_index:snow_anomaly"      = "Polygonal Index × Snow Anomaly",
"sd__(Intercept)"                = "Landscape Unit Random Effect"
)
