lowQ  <- quantile(wtd_dets$disturbance_index, 0.10, na.rm = TRUE)
highQ <- quantile(wtd_dets$disturbance_index, 0.90, na.rm = TRUE)
pred_young<- ggpredict(
m1_young,
terms = c("mean_snow_spatial [all]",
paste0("disturbance_index [", round(lowQ, 2), ",", round(highQ, 2), "]")),
type = "fe"
)%>%
rename(mean_snow_spatial = x,
disturbance_quantile = group)
ggplot(pred_young, aes(x = mean_snow_spatial, y = predicted, colour = disturbance_quantile)) +
geom_line(size = 1.2) +
geom_ribbon(aes(ymin = conf.low, ymax = conf.high, fill = disturbance_quantile),
alpha = 0.15, colour = NA) +
labs(
x = "Scaled Mean Long term snow load",
y = "Predicted Probability of Deer Presence",
colour = "Disturbance Index level",
fill = "Disturbance level",
title = "Lone Adult Females"
) +
scale_colour_manual(values = c("#0072B2", "#D55E00"),
labels = c("Low disturbance", "High disturbance")) +
scale_fill_manual(values = c("#0072B2", "#D55E00"), guide = "none")+
#                  labels = c("Low disturbance", "High disturbance")) +
theme_classic(base_size = 14)
