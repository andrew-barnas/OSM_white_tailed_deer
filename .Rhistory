Sampling_days = runif(n, 8, 122)
)
dat <- dat %>%
dplyr::mutate(effort = Sampling_days / 122)
# -----------------------------
# Linear predictor
# -----------------------------
eta <- beta_true["(Intercept)"] +
beta_true["MAT"] * dat$MAT +
beta_true["PercentConifer"] * dat$PercentConifer +
beta_true["PercentBroadleaf"] * dat$PercentBroadleaf +
beta_true["Harvest_11_25"] * dat$Harvest_11_25 +
beta_true["Lynx"] * dat$Lynx +
beta_true["Prey"] * dat$Prey +
beta_true["effort"] * dat$effort
p <- plogis(eta)
dat$Wolverine <- rbinom(n, 1, p)
# -----------------------------
# Fit model
# -----------------------------
fit <- glm(
Wolverine ~ MAT +
PercentConifer +
PercentBroadleaf +
Harvest_11_25 +
Lynx +
Prey +
effort,
family = binomial(),
data = dat
)
results[i, ] <- coef(fit)
}
simulate_wolverine_lowN <- function(n = 146, nsim = 500, seed = 123){
set.seed(seed)
# -----------------------------
# True parameter values
# -----------------------------
beta_true <- c(
"(Intercept)" = -6.53,
"MAT" = -1.29,
"PercentConifer" = 0.03,
"PercentBroadleaf" = 0.06,
"Harvest_11_25" = -0.12,
"Lynx" = 1.23,
"Prey" = 1.04,
"effort" = 3.14
)
# Storage
results <- matrix(NA, nsim, length(beta_true))
colnames(results) <- names(beta_true)
for(i in 1:nsim){
# -----------------------------
# Simulate covariates
# -----------------------------
dat <- data.frame(
MAT = rnorm(n, mean = 2, sd = 3),
PercentConifer = runif(n, 0, 50),
PercentBroadleaf = runif(n, 0, 50),
Harvest_11_25 = runif(n, 0, 1),
Lynx = rbinom(n, 1, 0.5),
Prey = rbinom(n, 1, 0.5),
Sampling_days = runif(n, 8, 122)
)
dat <- dat %>%
dplyr::mutate(effort = Sampling_days / 122)
# -----------------------------
# Linear predictor
# -----------------------------
eta <- beta_true["(Intercept)"] +
beta_true["MAT"] * dat$MAT +
beta_true["PercentConifer"] * dat$PercentConifer +
beta_true["PercentBroadleaf"] * dat$PercentBroadleaf +
beta_true["Harvest_11_25"] * dat$Harvest_11_25 +
beta_true["Lynx"] * dat$Lynx +
beta_true["Prey"] * dat$Prey +
beta_true["effort"] * dat$effort
p <- plogis(eta)
dat$Wolverine <- rbinom(n, 1, p)
# -----------------------------
# Fit model
# -----------------------------
fit <- glm(
Wolverine ~ MAT +
PercentConifer +
PercentBroadleaf +
Harvest_11_25 +
Lynx +
Prey +
effort,
family = binomial(),
data = dat
)
results[i, ] <- coef(fit)
}
# -----------------------------
# Tidy results
# -----------------------------
library(tidyverse)
results_df <- as.data.frame(results) %>%
mutate(sim = 1:nsim) %>%
pivot_longer(-sim, names_to = "term", values_to = "estimate")
# -----------------------------
# Plot
# -----------------------------
p <- ggplot(results_df, aes(x = estimate)) +
geom_histogram(bins = 30) +
facet_wrap(~ term, scales = "free") +
geom_vline(data = tibble(term = names(beta_true),
true = beta_true),
aes(xintercept = true),
linetype = "dashed") +
theme_bw() +
labs(title = "Sampling Distribution of Logistic Coefficients (n = 146)",
x = "Estimated Coefficient",
y = "Frequency")
return(list(results = results_df, plot = p))
}
out <- simulate_wolverine_lowN()
out$plot
