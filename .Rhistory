y = "Frequency"
) +
theme_classic() +
theme(axis.title = element_text(size = 10))
})
# 4. Arrange
final_plot <- ggpubr::ggarrange(
plotlist = plot_list,
ncol = 3, nrow = 3,
labels = "AUTO"
)
final_plot
# 4. Arrange
variables_plot <- ggpubr::ggarrange(
plotlist = plot_list,
ncol = 3, nrow = 3,
labels = "AUTO"
)
ggsave(filename = "variables_plot.jpeg", #name
plot = variables_plot,  #plot you want to save
path = figure_directory, #where its saved
width =3000, #how wide
height = 2000,#how tall
units = "px", #units in pixels
bg = 'white') #make sure background is white
#Lets write that file and move on to modeling!
write.csv(wtd_dets, file.path(output_directory, "final_df.csv"),
row.names = FALSE)
