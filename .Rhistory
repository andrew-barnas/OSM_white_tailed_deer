geom_density(fill = "grey", alpha = 0.4)+
geom_vline(xintercept = ref_values[i], color = "red", linetype = "dashed", linewidth = 1) +
theme_classic()+
theme(axis.title = element_text(size = 15),
axis.text = element_text(size = 12))
}
