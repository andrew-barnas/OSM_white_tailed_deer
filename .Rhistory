install.packages("jsonlite")
library(jsonlite)
rm(list=ls())
library(jsonlite)
# ---- paths ----
json_in  <- "C:/Users/16043/Desktop/CWS Whooping Crane Project/WHCR_Nest_2506/file_MD.json"
json_out <- "C:/Users/16043/Desktop/CWS Whooping Crane Project/WHCR_Nest_2506/file_MD_fixed.json"
# ---- read json ----
md <- fromJSON(json_in, simplifyVector = FALSE)
# ---- fix file paths ----
md$images <- lapply(md$images, function(img) {
# remove leading slash if present
fname <- sub("^/", "", img$file)
# enforce relative path (project root)
img$file <- fname
return(img)
})
# ---- write json ----
write_json(
md,
json_out,
pretty = TRUE,
auto_unbox = TRUE
)
cat("✔ Timelapse-ready JSON written to:", json_out, "\n")
