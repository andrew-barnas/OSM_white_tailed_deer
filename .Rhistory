x_labels <- c(
"(Intercept)"                    = "Intercept",
"lat"                            = "Latitude",
"polygonal_index"                   = "Polygonal Index",
"PC1"                            = "PC1",
"PC2"                            = "PC2",
"predator_index"                 = "Predator Index",
"mean_snow_spatial"              = "Mean Snow",
"snow_anomaly"                   = "Snow Anomaly",
"polygonal_index:mean_snow_spatial" = "Polygonal Index × Mean Snow",
"polygonal_index:snow_anomaly"      = "Polygonal Index × Snow Anomaly",
"sd__(Intercept)"                = "Landscape Unit Random Effect"
)
#This will pull the refence values for each class (dashed line true value)
#get_ref_values <- function(class) {
#  lm %>%
#    filter(class == !!class) %>%
#    select(term, estimate) %>%
#    deframe()
#}
plot_simulation_results <- function(class, param_estimates) {
# Reference values for dashed lines
#ref_values <- get_ref_values(class)
ref_values <- pm %>%
filter(class == !!class) %>%
select(term, estimate)
# Subset simulation output
df_class <- param_estimates %>%
filter(class == !!class)
plots <- list()
for (term_i in unique(df_class$term)) {
df_temp <- df_class %>%
filter(term == term_i)
plots[[term_i]] <- ggplot(df_temp, aes(x = estimate)) +
geom_density(fill = "grey", alpha = 0.4) +
geom_vline(
xintercept = ref_values$estimate[ref_values$term == term_i],
color = "red",
linetype = "dashed",
linewidth = 1
) +
labs(
x = x_labels[term_i],
y = "Density"
) +
scale_x_continuous(labels = function(x) sprintf("%.2f", x)) +
theme_classic() +
theme(
axis.title = element_text(size = 15),
axis.text  = element_text(size = 12)
)
}
combined <- ggpubr::ggarrange(
plotlist = plots,
ncol = 3,
nrow = 4,
labels = "AUTO",
font.label = list(size = 14, face = "bold"))
combined<-ggpubr::annotate_figure(
combined,
top = ggpubr::text_grob(
paste("Simulation Results: Linear Model –", tools::toTitleCase(class)),
face = "bold",
size = 18))
}
#Actually generate all three plots now
plots_by_class <- list(
males   = plot_simulation_results("males", param_estimates),
females = plot_simulation_results("females", param_estimates),
young   = plot_simulation_results("young", param_estimates)
)
