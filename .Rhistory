y = predicted,
colour = polygonal_quantile_label)) +
geom_line(size = 1.2) +
geom_ribbon(aes(ymin = conf.low,
ymax = conf.high,
fill = polygonal_quantile_label),
alpha = 0.15, colour = NA) +
scale_colour_manual(values = okabe_ito_polgyonal,
